# Copy this file to secrets.toml (same folder) to turn on "Continue with Google". secrets.toml is git-ignored.
# 1. Google Cloud console > APIs and Services > Credentials > Create OAuth client ID (Web application).
# 2. Add http://localhost:8501/oauth2callback as an authorised redirect URI.
# 3. Paste the client ID and secret below, and replace cookie_secret with any long random string.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-string"

[auth.google]
client_id = "your-client-id.apps.googleusercontent.com"
client_secret = "your-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
